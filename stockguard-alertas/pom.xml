<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stockguard</groupId>
        <artifactId>stockguard</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>stockguard-alertas</artifactId>
    <packaging>bundle</packaging>

    <name>StockGuard - Bundle de Alertas</name>

    <dependencies>
        <!-- Contrato público del módulo Inventario -->
        <dependency>
            <groupId>com.stockguard</groupId>
            <artifactId>stockguard-inventario</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Anotaciones para Declarative Services -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.9</version>
                <extensions>true</extensions>

                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>
                            com.stockguard.alertas
                        </Bundle-SymbolicName>

                        <Private-Package>
                            com.stockguard.alertas.internal*
                        </Private-Package>

                        <_dsannotations>*</_dsannotations>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
